#!/bin/sh
set -eu

ensure_system_account() {
    if ! getent group touchway-adsb-forwarder >/dev/null 2>&1; then
        addgroup --system touchway-adsb-forwarder >/dev/null
    fi

    if ! id touchway-adsb-forwarder >/dev/null 2>&1; then
        adduser \
            --system \
            --ingroup touchway-adsb-forwarder \
            --no-create-home \
            --home /usr/lib/touchway-adsb-forwarder \
            --shell /usr/sbin/nologin \
            touchway-adsb-forwarder >/dev/null
    fi
}

require_systemctl() {
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "systemctl is required to manage touchway-adsb-forwarder.service" >&2
        exit 1
    fi
}

reload_systemd() {
    require_systemctl
    systemctl daemon-reload >/dev/null 2>&1
}

restart_service_or_fail() {
    require_systemctl
    if ! systemctl restart touchway-adsb-forwarder.service >/dev/null 2>&1; then
        echo "failed to restart touchway-adsb-forwarder.service during package upgrade" >&2
        echo "inspect: systemctl status touchway-adsb-forwarder && journalctl -u touchway-adsb-forwarder" >&2
        exit 1
    fi
}

case "${1:-configure}" in
    configure)
        ensure_system_account
        reload_systemd

        if [ -n "${2:-}" ]; then
            restart_service_or_fail
            exit 0
        fi

        cat <<'EOF'
touchway-adsb-forwarder installed.
The service is still stopped and disabled.
Edit /etc/touchway-adsb-forwarder/forwarder.env before enabling it:
  sudoedit /etc/touchway-adsb-forwarder/forwarder.env
  sudo systemctl enable --now touchway-adsb-forwarder
  sudo systemctl status touchway-adsb-forwarder
  sudo journalctl -u touchway-adsb-forwarder -f
EOF
        ;;
esac

exit 0

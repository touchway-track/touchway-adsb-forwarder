[Unit]
Description=Touchway ADS-B Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=touchway-adsb-forwarder
Group=touchway-adsb-forwarder
EnvironmentFile=/etc/touchway-adsb-forwarder/forwarder.env
WorkingDirectory=/usr/lib/touchway-adsb-forwarder
ExecStartPre=/bin/sh -c '[ -n "$BACKEND_URL" ] && [ -n "$HMAC_SECRET" ]'
ExecStart=/usr/bin/python3 /usr/lib/touchway-adsb-forwarder/forward.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/run/dump1090-fa
ReadOnlyPaths=/var/cache/piaware

[Install]
WantedBy=multi-user.target

# Default environment values for Docker-based development workflows.
# Safe to commit; contains only localhost-oriented defaults.
# `docker-compose.dev.yml` loads this file directly—copy it locally if you
# need to customize values or point at a different backend.
BACKEND_URL=http://localhost:8080/adsb/ingest
FEEDER_ID=ff-poc-01
SITE_ID=site-poc
HMAC_SECRET=
INTERVAL_SEC=3
USE_GZIP=1
HTTP_TIMEOUT_SEC=5
SOURCE_FILE=/data/aircraft.json

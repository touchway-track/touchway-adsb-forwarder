# Default environment values for Docker-based development workflows.
# Safe to commit; contains only localhost-oriented defaults.
# `docker-compose.dev.yml` already loads these values via ./dev.env, so this
# file is primarily for manual docker runs or quick reference. Keep in sync
# with dev.env when updating defaults.
BACKEND_URL=http://localhost:8080/adsb/ingest
FEEDER_ID=ff-poc-01
SITE_ID=site-poc
HMAC_SECRET=
INTERVAL_SEC=3
USE_GZIP=1
HTTP_TIMEOUT_SEC=5
SOURCE_FILE=/data/aircraft.json

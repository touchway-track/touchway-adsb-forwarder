# Native runtime environment for the Touchway ADS-B forwarder.
# The Debian package installs this file at `/etc/touchway-adsb-forwarder/forwarder.env`.
# Set `FEEDER_ID` explicitly for native installs when possible. If you leave it
# blank, the forwarder falls back to `/var/cache/piaware/feeder_id`.
# Set `BACKEND_URL` and `HMAC_SECRET` before enabling `touchway-adsb-forwarder.service`.
# For local Docker-based development, use `.docker/dev.env` instead.
BACKEND_URL=
FEEDER_ID=
HMAC_SECRET=
INTERVAL_SEC=3
USE_GZIP=1
HTTP_TIMEOUT_SEC=5
# Leave FEEDER_ID blank only when you want Piaware fallback.
SOURCE_FILE=/run/dump1090-fa/aircraft.json

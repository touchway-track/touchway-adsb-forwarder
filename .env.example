# Production runtime environment template for the ADS-B forwarder.
# Copy this file to `/opt/adsb-forwarder/forwarder.env` on the feeder and fill in
# the required values. For the deployed image version, use `compose.env.example`
# as the template for `/opt/adsb-forwarder/.env`.
# For local Docker-based development, use `.docker/dev.env` instead.
BACKEND_URL=
FEEDER_ID=
HMAC_SECRET=
INTERVAL_SEC=3
USE_GZIP=1
HTTP_TIMEOUT_SEC=5
# Leave FEEDER_ID blank to auto-detect from /var/cache/piaware/feeder_id.
# HMAC_SECRET is required for the supported production deployment.
SOURCE_FILE=/run/dump1090-fa/aircraft.json

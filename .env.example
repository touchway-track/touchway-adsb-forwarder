# Example environment configuration for the ADS-B forwarder
# Copy this file to `.env` (local dev) or `forwarder.env` (production) and edit the values.
BACKEND_URL=http://localhost:8080/adsb/ingest
FEEDER_ID=ff-poc-01
SITE_ID=site-poc
HMAC_SECRET=
INTERVAL_SEC=3
USE_GZIP=1
HTTP_TIMEOUT_SEC=5
# Production feeders usually read from /run/dump1090-fa/aircraft.json
SOURCE_FILE=/data/aircraft.json
